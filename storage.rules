rules_version = '2';

// Règles de sécurité Firebase Storage pour Assa Crochet.
// - Tout le monde peut LIRE les photos (elles doivent s'afficher pour vos visiteurs).
// - Seule une personne connectée (vous, via l'espace pro) peut en AJOUTER/SUPPRIMER.
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
